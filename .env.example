# Endpoint que recibe el JSON del formulario de contacto.
# Puede ser un formulario de Formspree, un webhook de Make/Zapier o una Lambda propia.
# Si no se define, el formulario muestra un fallback mailto: y la Action devuelve
# SERVICE_UNAVAILABLE.
CONTACT_WEBHOOK_URL=

# URL pública del sitio (se usa en canonical, sitemap, hreflang y OG).
# En producción: https://tu-dominio.com
SITE_URL=https://grecodev.vercel.app
