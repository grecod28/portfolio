---
import { translatePath, type Locale } from '../i18n/utils';

interface Props {
	locale: Locale;
	currentPath: string;
}

const { locale, currentPath } = Astro.props;

const itemClass = (active: boolean) =>
	`inline-flex min-h-11 min-w-11 items-center justify-center px-2 font-mono text-[0.68rem] font-semibold tracking-[0.12em] transition-colors ${
		active ? 'bg-accent text-white' : 'text-muted hover:bg-surface hover:text-ink'
	}`;
---

<div
	class="flex items-center border border-line bg-surface p-0.5"
	role="group"
	aria-label="Idioma / Language"
>
	<a
		href={locale === 'es' ? currentPath : translatePath(currentPath, 'es')}
		hreflang="es-ES"
		lang="es"
		aria-current={locale === 'es' ? 'true' : undefined}
		class={itemClass(locale === 'es')}
	>
		<span class="sr-only">Español </span>ES
	</a>
	<a
		href={locale === 'en' ? currentPath : translatePath(currentPath, 'en')}
		hreflang="en-US"
		lang="en"
		aria-current={locale === 'en' ? 'true' : undefined}
		class={itemClass(locale === 'en')}
	>
		<span class="sr-only">English </span>EN
	</a>
</div>
