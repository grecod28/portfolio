---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useUI } from '../i18n/ui';
import { projectDetailPath, type Locale } from '../i18n/utils';
import { getCover } from '../lib/covers';
import Icon from './Icon.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useUI(locale);
const { title, tagline, stack, cover, coverAlt } = project.data;
const coverImage = getCover(cover);
const href = projectDetailPath(locale, project.id);
const visibleStack = stack.slice(0, 6);
const extraCount = stack.length - visibleStack.length;
---

<a
	href={href}
	class="group flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900"
>
	{
		coverImage ? (
			<div class="overflow-hidden border-b border-neutral-200 dark:border-neutral-800">
				<Image
					src={coverImage}
					alt={coverAlt[locale]}
					width={800}
					format="webp"
					quality={80}
					loading="lazy"
					class="aspect-16/10 w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
				/>
			</div>
		) : (
			<div
				class="flex aspect-16/10 w-full items-center justify-center border-b border-dashed border-neutral-200 bg-neutral-100 font-mono text-xs text-neutral-500 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-500"
			>
				{t.project.coverPending}
			</div>
		)
	}
	<div class="flex flex-1 flex-col gap-3 p-5">
		<h3 class="text-lg font-semibold tracking-tight">{title[locale]}</h3>
		<p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
			{tagline[locale]}
		</p>
		<ul class="mt-auto flex flex-wrap gap-1.5 pt-3" aria-label={t.project.stack}>
			{visibleStack.map((tech) => (
				<li class="chip">{tech}</li>
			))}
			{extraCount > 0 && <li class="chip">+{extraCount}</li>}
		</ul>
		<span
			class="inline-flex items-center gap-1.5 pt-2 text-sm font-medium text-indigo-600 dark:text-indigo-400"
		>
			{t.projects.viewProject}
			<Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-0.5" />
		</span>
	</div>
</a>
