---
import { SITE } from '../config';
import { useUI } from '../i18n/ui';
import { pagePath, projectsIndexPath, type Locale, type PageKey } from '../i18n/utils';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangPicker from './LangPicker.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const pathname = Astro.url.pathname;
const home = pagePath(locale, 'home');
const projectsBase = projectsIndexPath(locale);

const navItems: { key: PageKey; label: string }[] = [
	{ key: 'home', label: t.nav.home },
	{ key: 'projects', label: t.nav.projects },
	{ key: 'about', label: t.nav.about },
	{ key: 'stack', label: t.nav.stack },
	{ key: 'contact', label: t.nav.contact },
];

const isActive = (key: PageKey) => {
	if (key === 'home') return pathname === home;
	if (key === 'projects') return pathname.startsWith(projectsBase);
	return pathname.startsWith(pagePath(locale, key));
};

const linkClass = (active: boolean) =>
	`relative inline-flex min-h-11 items-center px-2.5 font-mono text-[0.7rem] font-semibold tracking-[0.14em] uppercase transition-colors after:absolute after:inset-x-2.5 after:bottom-1.5 after:h-px after:origin-left after:bg-accent after:transition-transform after:duration-200 ${
		active
			? 'text-ink after:scale-x-100'
			: 'text-muted after:scale-x-0 hover:text-ink hover:after:scale-x-100'
	}`;
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/90 backdrop-blur-md">
	<div class="absolute inset-x-0 top-0 h-0.5 bg-line/70" aria-hidden="true">
		<span data-scroll-progress class="block h-full origin-left scale-x-0 bg-accent"></span>
	</div>
	<div class="container-page flex h-16 items-center justify-between gap-3 lg:h-[4.5rem]">
		<a href={home} class="flex shrink-0 items-center gap-3">
			<span class="blueprint-frame flex h-10 w-10 items-center justify-center bg-accent text-sm font-bold text-white">
				SG
			</span>
			<span class="hidden leading-tight sm:block">
				<span class="block text-sm font-semibold tracking-tight">{SITE.name}</span>
				<span class="block font-mono text-[0.6rem] tracking-[0.2em] text-muted uppercase">
					Blueprint portfolio
				</span>
			</span>
		</a>

		<nav aria-label={t.nav.primary} class="hidden items-center gap-0.5 lg:flex">
			{navItems.map((item) => (
				<a
					href={pagePath(locale, item.key)}
					class={linkClass(isActive(item.key))}
					aria-current={isActive(item.key) ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-1.5">
			<button
				type="button"
				data-command-open
				class="hidden min-h-11 items-center gap-2 border border-line bg-surface px-2.5 font-mono text-[0.65rem] font-semibold tracking-wide text-muted uppercase transition-colors hover:border-accent hover:text-accent-strong sm:inline-flex"
			>
				<Icon name="command" size={14} />
				<span class="sr-only">{t.command.open}</span>
				<span aria-hidden="true">⌘K</span>
			</button>
			<ThemeToggle {locale} />
			<LangPicker {locale} currentPath={pathname} />
			<a href={SITE.cv} download class="btn-primary hidden px-3 py-2 lg:inline-flex">
				<Icon name="download" size={15} />
				<span class="hidden xl:inline">{t.downloadCv}</span>
			</a>

			<button
				type="button"
				data-menu-toggle
				data-open-label={t.openMenu}
				data-close-label={t.closeMenu}
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label={t.openMenu}
				class="inline-flex h-11 w-11 items-center justify-center border border-transparent text-ink transition-colors hover:border-line hover:bg-surface lg:hidden"
			>
				<span data-menu-icon-open class="block">
					<Icon name="menu" size={20} />
				</span>
				<span data-menu-icon-close class="hidden">
					<Icon name="close" size={20} />
				</span>
			</button>
		</div>
	</div>

	<div id="mobile-menu" data-menu-panel hidden class="border-t border-line bg-paper lg:hidden">
		<nav aria-label={t.nav.primary} class="container-page flex flex-col py-3">
			{navItems.map((item) => (
				<a
					href={pagePath(locale, item.key)}
					class="flex min-h-11 items-center justify-between border-b border-line/70 py-2 font-mono text-xs font-semibold tracking-[0.14em] text-ink uppercase last:border-0"
					aria-current={isActive(item.key) ? 'page' : undefined}
				>
					{item.label}
					<Icon name="arrow-up-right" size={15} class="text-muted" />
				</a>
			))}
			<a href={SITE.cv} download class="btn-secondary mt-4">
				<Icon name="download" size={16} />
				{t.downloadCv}
			</a>
		</nav>
	</div>
</header>

<script>
	function initMenu() {
		const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
		if (!toggle || !panel || toggle.dataset.bound === 'true') return;
		toggle.dataset.bound = 'true';

		const openIcon = toggle.querySelector<HTMLElement>('[data-menu-icon-open]');
		const closeIcon = toggle.querySelector<HTMLElement>('[data-menu-icon-close]');

		const close = (returnFocus = true) => {
			panel.hidden = true;
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', toggle.dataset.openLabel ?? '');
			openIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
			if (returnFocus) toggle.focus();
		};

		const open = () => {
			panel.hidden = false;
			toggle.setAttribute('aria-expanded', 'true');
			toggle.setAttribute('aria-label', toggle.dataset.closeLabel ?? '');
			openIcon?.classList.add('hidden');
			closeIcon?.classList.remove('hidden');
			panel.querySelector<HTMLAnchorElement>('a')?.focus();
		};

		toggle.addEventListener('click', () => {
			if (panel.hidden) open();
			else close();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !panel.hidden) {
				event.preventDefault();
				close();
			}
		});

		document.addEventListener('pointerdown', (event) => {
			const target = event.target;
			if (
				!panel.hidden &&
				target instanceof Node &&
				!panel.contains(target) &&
				!toggle.contains(target)
			) {
				close(false);
			}
		});

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => close(false));
		});
	}

	initMenu();
	document.addEventListener('astro:page-load', initMenu);
</script>
