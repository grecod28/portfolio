---
interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	subtitle?: string;
	centered?: boolean;
	/** Número de sección, p. ej. "02". */
	number?: string;
}

const { id, eyebrow, title, subtitle, centered = false, number } = Astro.props;
---

<div class:list={['reveal', { 'text-center': centered }]}>
	<div class="flex items-baseline gap-3">
		{number && <span class="font-mono text-[0.68rem] tracking-[0.2em] text-muted">{number}</span>}
		{eyebrow && <p class="section-label">{eyebrow}</p>}
	</div>
	<h2 {id} class="mt-2 text-balance text-2xl font-semibold tracking-[-0.03em] text-ink sm:text-3xl">
		{title}
	</h2>
	{subtitle && <p class="mt-3 max-w-2xl text-pretty text-muted">{subtitle}</p>}
</div>
