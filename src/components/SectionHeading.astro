---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	centered?: boolean;
}

const { eyebrow, title, subtitle, centered = false } = Astro.props;
---

<div class:list={[{ 'text-center': centered }]}>
	{eyebrow && (
		<p class="font-mono text-xs font-semibold tracking-[0.2em] text-indigo-600 uppercase dark:text-indigo-400">
			{eyebrow}
		</p>
	)}
	<h2 class="mt-2 text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-white">
		{title}
	</h2>
	{subtitle && (
		<p class="mt-3 max-w-2xl text-neutral-600 dark:text-neutral-400">
			{subtitle}
		</p>
	)}
</div>
