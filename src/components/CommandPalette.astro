---
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { useUI } from '../i18n/ui';
import { otherLocale, pagePath, projectDetailPath, type Locale } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const pages = [
	{ key: 'home', label: t.nav.home, href: pagePath(locale, 'home') },
	{ key: 'projects', label: t.nav.projects, href: pagePath(locale, 'projects') },
	{ key: 'about', label: t.nav.about, href: pagePath(locale, 'about') },
	{ key: 'stack', label: t.nav.stack, href: pagePath(locale, 'stack') },
	{ key: 'contact', label: t.nav.contact, href: pagePath(locale, 'contact') },
] as const;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<dialog
	id="command-palette"
	data-command-dialog
	aria-labelledby="command-title"
	class="m-auto w-[min(92vw,44rem)] border border-line bg-surface p-0 text-ink shadow-paper [&::backdrop]:bg-ink/60 [&::backdrop]:backdrop-blur-sm"
>
	<div class="border-b border-line p-3">
		<h2 id="command-title" class="sr-only">
			{t.command.title}
		</h2>
		<div class="flex items-center gap-2">
			<Icon name="search" size={18} class="shrink-0 text-muted" />
			<input
				data-command-input
				type="search"
				role="combobox"
				aria-expanded="true"
				aria-controls="command-list"
				aria-autocomplete="list"
				aria-activedescendant=""
				autocomplete="off"
				spellcheck="false"
				placeholder={t.command.placeholder}
				class="min-h-11 w-full bg-transparent px-1 text-sm text-ink outline-none placeholder:text-muted/70"
			/>
			<button
				type="button"
				data-command-close
				class="inline-flex h-11 w-11 shrink-0 items-center justify-center text-muted transition-colors hover:bg-paper hover:text-ink"
				aria-label={t.command.close}
			>
				<Icon name="close" size={18} />
			</button>
		</div>
	</div>

	<div class="max-h-[min(60vh,30rem)] overflow-y-auto p-2">
		<ul id="command-list" role="listbox" aria-label={t.command.title} class="space-y-0.5">
			<li class="px-2 pt-2 pb-1">
				<span class="section-label">{t.command.pages}</span>
			</li>
			{pages.map((page, index) => (
				<li
					role="option"
					id={`command-page-${page.key}`}
					data-command-item
					data-href={page.href}
					data-label={`${page.label} ${t.command.pages}`}
					aria-selected="false"
					class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm data-[active=true]:bg-paper data-[active=true]:text-accent-strong"
				>
					<span class="flex items-center gap-2.5">
						<span class="font-mono text-[0.62rem] text-muted">
							{String(index + 1).padStart(2, '0')}
						</span>
						{page.label}
					</span>
					<Icon
						name="arrow-up-right"
						size={14}
						class="text-muted opacity-0 group-data-[active=true]:opacity-100"
					/>
				</li>
			))}
			<li class="px-2 pt-4 pb-1">
				<span class="section-label">{t.command.projects}</span>
			</li>
			{projects.map((project) => (
				<li
					role="option"
					id={`command-project-${project.id}`}
					data-command-item
					data-href={projectDetailPath(locale, project.id)}
					data-label={`${project.data.title[locale]} ${t.command.projects}`}
					aria-selected="false"
					class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm data-[active=true]:bg-paper data-[active=true]:text-accent-strong"
				>
					<span>{project.data.title[locale]}</span>
					<span class="font-mono text-[0.62rem] text-muted">{project.data.stack[0]}</span>
				</li>
			))}
			<li class="px-2 pt-4 pb-1">
				<span class="section-label">{t.command.actions}</span>
			</li>
			<li
				role="option"
				id="command-action-theme"
				data-command-item
				data-command-action="theme"
				data-label={`${t.command.theme} ${t.command.actions}`}
				aria-selected="false"
				class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm data-[active=true]:bg-paper data-[active=true]:text-accent-strong"
			>
				<span class="flex items-center gap-2.5">
					<Icon name="sun" size={15} class="text-muted" />
					{t.command.theme}
				</span>
				<span class="font-mono text-[0.62rem] text-muted">T</span>
			</li>
			<li
				role="option"
				id="command-action-language"
				data-command-item
				data-command-action="language"
				data-label={`${t.command.language} ${t.command.actions}`}
				aria-selected="false"
				class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm data-[active=true]:bg-paper data-[active=true]:text-accent-strong"
			>
				<span class="flex items-center gap-2.5">
					<Icon name="info" size={15} class="text-muted" />
					{t.command.language}
				</span>
				<span class="font-mono text-[0.62rem] text-muted">{otherLocale(locale).toUpperCase()}</span>
			</li>
			<li
				role="option"
				id="command-action-cv"
				data-command-item
				data-command-action="cv"
				data-label={`${t.command.cv} ${t.command.actions}`}
				aria-selected="false"
				class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm data-[active=true]:bg-paper data-[active=true]:text-accent-strong"
			>
				<span class="flex items-center gap-2.5">
					<Icon name="download" size={15} class="text-muted" />
					{t.command.cv}
				</span>
				<span class="font-mono text-[0.62rem] text-muted">PDF</span>
			</li>
			<li
				role="option"
				id="command-action-email"
				data-command-item
				data-command-action="email"
				data-label={`${t.command.email} ${t.command.actions}`}
				aria-selected="false"
				class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm data-[active=true]:bg-paper data-[active=true]:text-accent-strong"
			>
				<span class="flex items-center gap-2.5">
					<Icon name="copy" size={15} class="text-muted" />
					{t.command.email}
				</span>
				<span class="font-mono text-[0.62rem] text-muted">{SITE.email}</span>
			</li>
		</ul>
		<p data-command-empty hidden class="px-3 py-8 text-center text-sm text-muted">
			{t.command.noResults}
		</p>
	</div>

	<div class="flex flex-wrap items-center justify-between gap-2 border-t border-line px-3 py-2 font-mono text-[0.62rem] tracking-wide text-muted uppercase">
		<span>{t.command.hint}</span>
		<span data-command-status data-copied-label={t.command.copied} aria-live="polite"></span>
	</div>
</dialog>

<script>
	import { navigate } from 'astro:transitions/client';
	import { SITE } from '../config';
	import { otherLocale, translatePath, type Locale } from '../i18n/utils';

	const locale = document.documentElement.lang.startsWith('en') ? 'en' : 'es';
	let lastTrigger: HTMLElement | null = null;

	if (!(window as Window & { __portfolioPaletteKeyBound?: boolean }).__portfolioPaletteKeyBound) {
		(window as Window & { __portfolioPaletteKeyBound?: boolean }).__portfolioPaletteKeyBound = true;
		document.addEventListener('keydown', (event) => {
			if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				const dialog = document.querySelector<HTMLDialogElement>('[data-command-dialog]');
				if (dialog?.open) dialog.close();
				else document.querySelector<HTMLElement>('[data-command-open]')?.click();
			}
		});
	}

	function setupPalette() {
		const dialog = document.querySelector<HTMLDialogElement>('[data-command-dialog]');
		if (!dialog || dialog.dataset.bound === 'true') return;
		dialog.dataset.bound = 'true';

		const input = dialog.querySelector<HTMLInputElement>('[data-command-input]');
		const list = dialog.querySelector<HTMLElement>('#command-list');
		const empty = dialog.querySelector<HTMLElement>('[data-command-empty]');
		const status = dialog.querySelector<HTMLElement>('[data-command-status]');
		const closeButton = dialog.querySelector<HTMLButtonElement>('[data-command-close]');
		if (!input || !list) return;

		let activeIndex = -1;

		const items = () => Array.from(list.querySelectorAll<HTMLElement>('[data-command-item]'));
		const visibleItems = () =>
			items().filter((item) => !item.hidden && item.getAttribute('aria-selected') !== null);

		const setActive = (index: number) => {
			const visible = visibleItems();
			visible.forEach((item) => {
				item.dataset.active = 'false';
				item.setAttribute('aria-selected', 'false');
			});
			activeIndex = index;
			const item = visible[activeIndex];
			if (item) {
				item.dataset.active = 'true';
				item.setAttribute('aria-selected', 'true');
				input.setAttribute('aria-activedescendant', item.id);
				item.scrollIntoView({ block: 'nearest' });
			} else {
				input.removeAttribute('aria-activedescendant');
			}
		};

		const filter = () => {
			const query = input.value.trim().toLowerCase();
			for (const item of items()) {
				const label = (item.dataset.label ?? '').toLowerCase();
				item.hidden = query.length > 0 && !label.includes(query);
				item.setAttribute('aria-selected', 'false');
				item.dataset.active = 'false';
			}
			const visible = visibleItems();
			if (empty) empty.hidden = visible.length > 0;
			activeIndex = -1;
			setActive(visible.length > 0 ? 0 : -1);
		};

		const close = () => {
			if (dialog.open) dialog.close();
			lastTrigger?.focus();
		};

		const execute = (item: HTMLElement) => {
			const action = item.dataset.commandAction;
			const href = item.dataset.href;
			if (action === 'theme') {
				document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
				close();
				return;
			}
			if (action === 'language') {
				const target = translatePath(window.location.pathname, otherLocale(locale as Locale));
				close();
				navigate(target);
				return;
			}
			if (action === 'cv') {
				window.location.href = SITE.cv;
				close();
				return;
			}
			if (action === 'email') {
				navigator.clipboard
					?.writeText(SITE.email)
					.then(() => {
						if (status) status.textContent = status.dataset.copiedLabel ?? '';
					})
					.catch(() => {
						window.location.href = `mailto:${SITE.email}`;
					});
				return;
			}
			if (href) {
				close();
				navigate(href);
			}
		};

		const open = (trigger?: HTMLElement) => {
			lastTrigger = trigger ?? null;
			input.value = '';
			filter();
			if (typeof dialog.showModal === 'function') dialog.showModal();
			else dialog.setAttribute('open', '');
			requestAnimationFrame(() => input.focus());
		};

		document.querySelectorAll<HTMLElement>('[data-command-open]').forEach((trigger) => {
			trigger.addEventListener('click', () => open(trigger));
		});

		input.addEventListener('input', filter);

		input.addEventListener('keydown', (event) => {
			const visible = visibleItems();
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				setActive((activeIndex + 1) % Math.max(visible.length, 1));
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				setActive((activeIndex - 1 + visible.length) % Math.max(visible.length, 1));
			} else if (event.key === 'Home') {
				event.preventDefault();
				setActive(0);
			} else if (event.key === 'End') {
				event.preventDefault();
				setActive(visible.length - 1);
			} else if (event.key === 'Enter') {
				event.preventDefault();
				if (visible[activeIndex]) execute(visible[activeIndex]);
			}
		});

		list.addEventListener('click', (event) => {
			const item = (event.target as HTMLElement).closest<HTMLElement>('[data-command-item]');
			if (item) execute(item);
		});

		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) close();
		});

		dialog.addEventListener('close', () => {
			lastTrigger?.focus();
		});

		closeButton?.addEventListener('click', close);
	}

	setupPalette();
	document.addEventListener('astro:page-load', setupPalette);
</script>
