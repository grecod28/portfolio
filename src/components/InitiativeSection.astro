---
/**
 * Sección "Iniciativa": hechos concretos en tarjetas, sin autoelogios.
 */
import type { Locale } from '../i18n/utils';
import { useUI } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const cards = t.home.initiative;
---

<section aria-labelledby="initiative-title" class="container-page py-section">
	<SectionHeading
		id="initiative-title"
		number="04"
		eyebrow={t.home.initiativeEyebrow}
		title={t.home.initiativeTitle}
	/>
	<ul class="mt-10 grid gap-4 sm:grid-cols-2">
		{cards.map((card, index) => (
			<li class="reveal border border-line bg-surface p-6">
				<div class="flex items-start justify-between gap-4">
					<span class="font-mono text-[0.68rem] tracking-[0.2em] text-accent-strong">
						{String(index + 1).padStart(2, '0')}
					</span>
					<span class="h-2 w-2 bg-line" aria-hidden="true" />
				</div>
				<h3 class="mt-5 font-semibold tracking-tight">{card.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-muted">{card.text}</p>
			</li>
		))}
	</ul>
</section>
