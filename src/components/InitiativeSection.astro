---
/**
 * Sección "Iniciativa": hechos concretos en tarjetas, sin autoelogios.
 */
import type { Locale } from '../i18n/utils';
import { useUI } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const cards = t.home.initiative;
---

<section aria-labelledby="initiative-title" class="container-page py-16 sm:py-20">
	<div class="mb-8">
		<SectionHeading
			eyebrow={t.home.initiativeEyebrow}
			title={t.home.initiativeTitle}
		/>
	</div>
	<ul class="grid gap-4 sm:grid-cols-2">
		{cards.map((card, index) => (
			<li class="card animate-rise p-6" style={`animation-delay: ${index * 80}ms`}>
				<div
					class="mb-3 flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600/10 font-mono text-sm font-bold text-indigo-600 dark:bg-indigo-400/10 dark:text-indigo-400"
					aria-hidden="true"
				>
					{String(index + 1).padStart(2, '0')}
				</div>
				<h3 class="font-semibold tracking-tight">{card.title}</h3>
				<p class="mt-1.5 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
					{card.text}
				</p>
			</li>
		))}
	</ul>
</section>
