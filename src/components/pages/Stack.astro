---
/**
 * Página "Tecnologías" (compartida entre /es y /en).
 */
import { useUI } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const groups = [
	{
		key: 'frontend' as const,
		techs: ['Next.js (App Router)', 'React', 'Angular', 'TypeScript', 'Tailwind CSS', 'Sass'],
	},
	{
		key: 'backend' as const,
		techs: ['NestJS', 'Node.js', 'APIs REST', 'WebSockets', 'BullMQ'],
	},
	{
		key: 'data' as const,
		techs: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis', 'Prisma', 'TypeORM', 'Mongoose'],
	},
	{
		key: 'infra' as const,
		techs: ['Docker', 'AWS', 'Nginx', 'GitHub Actions'],
	},
];
---

<section class="container-page py-12 sm:py-16">
	<header class="max-w-2xl animate-rise space-y-4">
		<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t.stack.title}</h1>
		<p class="text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">{t.stack.intro}</p>
	</header>

	<ul class="mt-10 grid gap-6 sm:grid-cols-2">
		{groups.map((group) => (
			<li class="card p-6">
				<h2 class="font-mono text-xs font-semibold tracking-[0.2em] text-indigo-600 uppercase dark:text-indigo-400">
					{t.stack.groups[group.key]}
				</h2>
				<ul class="mt-4 flex flex-wrap gap-1.5">
					{group.techs.map((tech) => (
						<li class="chip">{tech}</li>
					))}
				</ul>
			</li>
		))}
	</ul>

	<section
		aria-labelledby="learning"
		class="mt-16 rounded-3xl border-2 border-dashed border-indigo-300 bg-indigo-50/70 p-8 sm:p-10 dark:border-indigo-500/40 dark:bg-indigo-500/10"
	>
		<p class="font-mono text-xs font-semibold tracking-[0.2em] text-indigo-600 uppercase dark:text-indigo-400">
			{t.stack.learningEyebrow}
		</p>
		<h2 id="learning" class="mt-2 text-2xl font-bold tracking-tight">
			{t.stack.learningTitle}
		</h2>
		<p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
			{t.stack.learningNote}
		</p>
		<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{t.stack.learningTopics.map((topic) => (
				<li
					class="flex gap-2.5 rounded-xl border border-indigo-200 bg-white p-3.5 text-sm font-medium text-neutral-800 dark:border-indigo-500/30 dark:bg-neutral-900 dark:text-neutral-200"
				>
					<Icon name="check" size={16} class="mt-0.5 shrink-0 text-indigo-600 dark:text-indigo-400" />
					{topic}
				</li>
			))}
		</ul>
		<p
			class="mt-6 inline-flex rounded-full border border-indigo-200 bg-white px-3.5 py-1.5 font-mono text-xs text-indigo-700 dark:border-indigo-500/30 dark:bg-neutral-900 dark:text-indigo-300"
		>
			{t.stack.awsNote}
		</p>
	</section>
</section>
