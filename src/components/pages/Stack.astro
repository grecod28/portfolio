---
/**
 * Página "Tecnologías" (compartida entre /es y /en).
 */
import { getCollection } from 'astro:content';
import type { SvgComponent } from 'astro/types';
import { useUI } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import TechIcon from '../TechIcon.astro';
import typescript from '../../assets/images/typescript-svgrepo-com.svg';
import react from '../../assets/images/react-svgrepo-com.svg';
import nextjs from '../../assets/images/nextjs-fill-svgrepo-com.svg';
import angular from '../../assets/images/angular-svgrepo-com.svg';
import tailwind from '../../assets/images/tailwind-svgrepo-com.svg';
import sass from '../../assets/images/sass-svgrepo-com.svg';
import nestjs from '../../assets/images/nestjs-svgrepo-com.svg';
import nodejs from '../../assets/images/nodejs-svgrepo-com.svg';
import express from '../../assets/images/express-svgrepo-com.svg';
import pgsql from '../../assets/images/pgsql-svgrepo-com.svg';
import mongo from '../../assets/images/mongo-svgrepo-com.svg';
import redis from '../../assets/images/redis-svgrepo-com.svg';
import docker from '../../assets/images/docker-svgrepo-com.svg';
import aws from '../../assets/images/aws-svgrepo-com.svg';
import nginx from '../../assets/images/nginx-svgrepo-com.svg';
import githubActions from '../../assets/images/github-actions.svg';
import astro from '../../assets/images/astro.svg';
import reactNative from '../../assets/images/react-native-svgrepo-com.svg';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const iconMap: Record<string, SvgComponent> = {
	nextjs,
	react,
	angular,
	typescript,
	tailwind,
	sass,
	astro,
	reactNative,
	nestjs,
	nodejs,
	express,
	pgsql,
	mongo,
	redis,
	docker,
	aws,
	nginx,
	githubActions,
};

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const groupKeys = ['frontend', 'backend', 'data', 'infra'] as const;
const groups = groupKeys.map((key) => ({
	key,
	techs: skills
		.filter((skill) => skill.data.group === key)
		.map((skill) => ({
			name: skill.data.name,
			icon: skill.data.icon ? iconMap[skill.data.icon] : undefined,
		})),
}));
---

<section class="container-page py-12 sm:py-16">
	<header class="max-w-3xl">
		<p class="section-label">04 / {t.nav.stack}</p>
		<h1 class="mt-3 text-3xl font-semibold tracking-[-0.045em] text-balance sm:text-4xl">
			{t.stack.title}
		</h1>
		<p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-muted">{t.stack.intro}</p>
	</header>

	<ul class="mt-10 grid gap-4 lg:grid-cols-2">
		{groups.map((group) => (
			<li class="reveal border border-line bg-surface p-6">
				<div class="flex items-center justify-between gap-4">
					<h2 class="section-label">{t.stack.groups[group.key]}</h2>
					<span class="font-mono text-[0.62rem] tracking-wide text-muted">
						{String(group.techs.length).padStart(2, '0')}
					</span>
				</div>
				<ul class="mt-5 grid gap-2 sm:grid-cols-2">
					{group.techs.map((tech) => (
						<li class="flex min-h-12 items-center gap-3">
							{tech.icon ? (
								<TechIcon icon={tech.icon} name={tech.name} />
							) : (
								<span class="flex h-12 w-12 shrink-0 items-center justify-center border border-line bg-paper font-mono text-[0.6rem] text-muted">
									·
								</span>
							)}
							<span class="text-sm font-medium">{tech.name}</span>
						</li>
					))}
				</ul>
			</li>
		))}
	</ul>

	<section
		aria-labelledby="learning"
		class="mt-16 border border-dashed border-warm/60 bg-surface p-8 sm:p-10"
	>
		<SectionHeading
			number="05"
			eyebrow={t.stack.learningEyebrow}
			title={t.stack.learningTitle}
			id="learning"
			subtitle={t.stack.learningNote}
		/>
		<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{t.stack.learningTopics.map((topic) => (
				<li class="flex gap-2.5 border border-line bg-paper p-3.5 text-sm font-medium">
					<Icon name="check" size={16} class="mt-0.5 shrink-0 text-warm" />
					{topic}
				</li>
			))}
		</ul>
		<p class="mt-6 inline-flex border border-warm/40 bg-paper px-3.5 py-1.5 font-mono text-[0.65rem] tracking-wide text-warm uppercase">
			{t.stack.awsNote}
		</p>
	</section>
</section>
