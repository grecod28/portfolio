---
/**
 * Página "Sobre mí" (compartida entre /es y /en).
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '../../config';
import { useUI } from '../../i18n/ui';
import { pagePath, type Locale } from '../../i18n/utils';
import foto from '../../assets/images/foto_perfil.png';
import InitiativeSection from '../InitiativeSection.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

const dotClass: Record<string, string> = {
	done: 'bg-ok',
	active: 'bg-accent',
	prep: 'bg-warm',
};

const contactPath = pagePath(locale, 'contact');
const projectsPath = pagePath(locale, 'projects');
const isPending = (value: string) => value.includes('TODO');
---

<section class="border-b border-line">
	<div class="container-page grid items-start gap-10 py-14 sm:py-20 lg:grid-cols-[1.2fr_0.8fr]">
		<div class="max-w-2xl">
			<p class="section-label">01 / {t.about.title}</p>
			<h1 class="mt-3 text-3xl font-semibold tracking-[-0.05em] text-balance sm:text-5xl">
				{t.about.title}
			</h1>
			<p class="mt-6 text-pretty text-lg leading-relaxed text-ink">{t.about.intro1}</p>
			<p class="mt-4 text-pretty leading-relaxed text-muted">{t.about.intro2}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href={contactPath} class="btn-primary">
					{t.nav.contact}
					<Icon name="arrow-right" size={16} />
				</a>
				<a href={SITE.cv} download class="btn-secondary">
					<Icon name="download" size={15} />
					{t.downloadCv}
				</a>
				<a href={projectsPath} class="btn-ghost">
					{t.nav.projects}
				</a>
			</div>
		</div>
		<div class="mx-auto w-full max-w-xs lg:justify-self-end">
			<div class="blueprint-frame border border-line bg-surface p-3 shadow-paper">
				<Picture
					src={foto}
					alt={locale === 'es' ? 'Retrato de Santiago Greco' : 'Portrait of Santiago Greco'}
					formats={['avif', 'webp']}
					fallbackFormat="webp"
					layout="constrained"
					width={480}
					height={600}
					loading="lazy"
					class="aspect-[4/5] w-full object-cover grayscale-[15%]"
				/>
				<p class="mt-3 border-t border-line pt-3 font-mono text-[0.62rem] tracking-[0.18em] text-muted uppercase">
					Santiago Greco · ES
				</p>
			</div>
		</div>
	</div>
</section>

<section class="container-page py-section">
	<SectionHeading
		number="02"
		eyebrow={t.about.experienceTitle}
		title={t.about.experienceTitle}
		subtitle={t.about.experienceNote}
	/>
	<ol class="mt-10 border-l border-line">
		{experience.map((job) => (
			<li class="relative pb-10 pl-7 last:pb-0">
				<span class="absolute top-1.5 -left-[5px] h-2.5 w-2.5 bg-accent" aria-hidden="true" />
				<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
					<h3 class="text-lg font-semibold tracking-tight">{job.data.company}</h3>
					<span
						class:list={[
							'font-mono text-[0.65rem] tracking-wide uppercase',
							isPending(job.data.period) ? 'text-warm' : 'text-muted',
						]}
					>
						{job.data.period}
					</span>
				</div>
				<p class="mt-1 text-sm font-medium text-accent-strong">{job.data.role[locale]}</p>
				<ul class="mt-4 space-y-2">
					{job.data.highlights[locale].map((highlight) => (
						<li class="flex gap-2.5 text-sm leading-relaxed text-muted">
							<Icon name="check" size={15} class="mt-0.5 shrink-0 text-accent" />
							<span>{highlight}</span>
						</li>
					))}
				</ul>
			</li>
		))}
	</ol>
</section>

<section class="border-y border-line bg-surface/50">
	<div class="container-page py-section">
		<SectionHeading number="03" eyebrow={t.about.educationTitle} title={t.about.educationTitle} />
		<ol class="mt-10 grid gap-4 md:grid-cols-3">
			{t.about.education.map((item) => (
				<li class="border border-line bg-surface p-5">
					<div class="flex items-center justify-between gap-3">
						<p class="font-mono text-[0.65rem] tracking-[0.15em] text-accent-strong uppercase">
							{item.period}
						</p>
						<span class:list={['h-2.5 w-2.5', dotClass[item.status]]} aria-hidden="true" />
					</div>
					<h3 class="mt-3 font-semibold tracking-tight">{item.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<InitiativeSection {locale} />
