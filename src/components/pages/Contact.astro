---
/**
 * Página "Contacto" (compartida entre /es y /en).
 * Formulario sin backend: compone un enlace mailto al enviar.
 */
import { SITE } from '../../config';
import { useUI } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const channels = [
	{ icon: 'mail' as const, label: 'Email', value: SITE.email, href: `mailto:${SITE.email}` },
	{ icon: 'linkedin' as const, label: 'LinkedIn', value: 'santiago-greco-dominguez', href: SITE.social.linkedin },
	{ icon: 'github' as const, label: 'GitHub', value: 'grecod28', href: SITE.social.github },
];
---

<section class="container-page py-12 sm:py-16">
	<header class="max-w-2xl animate-rise space-y-4">
		<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t.contact.title}</h1>
		<p class="text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">{t.contact.intro}</p>
	</header>

	<div class="mt-10 grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
		<section aria-labelledby="channels">
			<h2 id="channels" class="text-xl font-bold tracking-tight">{t.contact.channelsTitle}</h2>
			<ul class="mt-5 space-y-3">
				{channels.map((channel) => (
					<li>
						<a
							href={channel.href}
							target={channel.icon === 'mail' ? undefined : '_blank'}
							rel={channel.icon === 'mail' ? undefined : 'noopener noreferrer'}
							class="flex items-center gap-4 rounded-2xl border border-neutral-200 bg-white p-5 transition-colors hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
						>
							<span
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-600/10 text-indigo-600 dark:bg-indigo-400/10 dark:text-indigo-400"
							>
								<Icon name={channel.icon} size={20} />
							</span>
							<span class="min-w-0">
								<span class="block font-mono text-xs text-neutral-500 dark:text-neutral-500">
									{channel.label}
								</span>
								<span class="block truncate font-medium">{channel.value}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="form-title">
			<h2 id="form-title" class="text-xl font-bold tracking-tight">{t.contact.formTitle}</h2>
			<form id="contact-form" class="card mt-5 space-y-5 p-6 sm:p-8">
				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label for="contact-name" class="mb-1.5 block text-sm font-medium">
							{t.contact.formName}
						</label>
						<input id="contact-name" name="name" type="text" autocomplete="name" class="input" />
					</div>
					<div>
						<label for="contact-email" class="mb-1.5 block text-sm font-medium">
							{t.contact.formEmail}
						</label>
						<input id="contact-email" name="email" type="email" autocomplete="email" class="input" />
					</div>
				</div>
				<div>
					<label for="contact-message" class="mb-1.5 block text-sm font-medium">
						{t.contact.formMessage}
					</label>
					<textarea id="contact-message" name="message" rows="5" class="input" required></textarea>
				</div>
				<div class="flex flex-wrap items-center gap-4">
					<button type="submit" class="btn-primary">
						<Icon name="mail" size={16} />
						{t.contact.formSubmit}
					</button>
					<p class="text-sm text-neutral-500 dark:text-neutral-500">{t.contact.formNote}</p>
				</div>
			</form>
		</section>
	</div>
</section>

<script define:vars={{ email: SITE.email }}>
	const form = document.getElementById('contact-form');
	if (form instanceof HTMLFormElement) {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const name = String(data.get('name') ?? '').trim();
			const sender = String(data.get('email') ?? '').trim();
			const message = String(data.get('message') ?? '').trim();

			const subject = name ? `Contacto desde el portfolio — ${name}` : 'Contacto desde el portfolio';
			const body = [`Nombre: ${name}`, `Email: ${sender}`, '', message].join('\n');

			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});
	}
</script>
