---
/**
 * Página "Contacto" (compartida entre /es y /en).
 * Formulario validado en servidor con Astro Actions y webhook configurable.
 */
import { SITE } from '../../config';
import { useUI } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const channels = [
	{
		icon: 'mail' as const,
		label: 'Email',
		value: SITE.email,
		href: `mailto:${SITE.email}`,
	},
	{
		icon: 'linkedin' as const,
		label: 'LinkedIn',
		value: 'santiago-greco-dominguez',
		href: SITE.social.linkedin,
	},
	{
		icon: 'github' as const,
		label: 'GitHub',
		value: 'grecod28',
		href: SITE.social.github,
	},
];
---

<section class="container-page py-12 sm:py-16">
	<header class="max-w-3xl">
		<p class="section-label">05 / {t.nav.contact}</p>
		<h1 class="mt-3 text-3xl font-semibold tracking-[-0.045em] text-balance sm:text-4xl">
			{t.contact.title}
		</h1>
		<p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-muted">{t.contact.intro}</p>
	</header>

	<div class="mt-10 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
		<div class="space-y-6">
			<section aria-labelledby="channels">
				<h2 id="channels" class="section-label">
					{t.contact.channelsTitle}
				</h2>
				<ul class="mt-4 space-y-2">
					{channels.map((channel) => (
						<li>
							<a
								href={channel.href}
								target={channel.icon === 'mail' ? undefined : '_blank'}
								rel={channel.icon === 'mail' ? undefined : 'noopener noreferrer'}
								class="flex min-h-16 items-center gap-4 border border-line bg-surface p-4 transition-colors hover:border-accent"
							>
								<span class="flex h-11 w-11 shrink-0 items-center justify-center border border-line bg-paper text-accent-strong">
									<Icon name={channel.icon} size={19} />
								</span>
								<span class="min-w-0">
									<span class="block font-mono text-[0.62rem] tracking-wide text-muted uppercase">
										{channel.label}
									</span>
									<span class="block truncate text-sm font-medium">{channel.value}</span>
								</span>
								<Icon name="arrow-up-right" size={15} class="ml-auto shrink-0 text-muted" />
							</a>
						</li>
					))}
				</ul>
			</section>

			<div class="blueprint-frame border border-line bg-surface p-5">
				<p class="section-label">{t.home.idStatus}</p>
				<p class="mt-2 flex items-center gap-2 text-sm font-medium">
					<span class="h-2 w-2 rounded-full bg-ok" aria-hidden="true"></span>
					{t.home.idAvailability}
				</p>
				<p class="mt-2 text-sm leading-relaxed text-muted">{t.contact.formNote}</p>
			</div>
		</div>

		<section aria-labelledby="form-title" class="border border-line bg-surface p-6 sm:p-8">
			<h2 id="form-title" class="text-xl font-semibold tracking-tight">
				{t.contact.formTitle}
			</h2>
			<form
				id="contact-form"
				data-contact-form
				action={`mailto:${SITE.email}`}
				method="post"
				enctype="text/plain"
				class="mt-6 space-y-5"
				data-msg-success={t.contact.formSuccess}
				data-msg-error={t.contact.formError}
				data-msg-unavailable={t.contact.formServiceUnavailable}
				data-msg-sending={t.contact.formSending}
			>
				<input type="hidden" name="locale" value={locale} />
				<div class="hidden" aria-hidden="true">
					<label for="contact-website">Website</label>
					<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label
							for="contact-name"
							class="mb-1.5 block font-mono text-[0.65rem] tracking-wide text-muted uppercase"
						>
							{t.contact.formName}
						</label>
						<input
							id="contact-name"
							name="name"
							type="text"
							autocomplete="name"
							required
							maxlength="80"
							class="input"
							aria-describedby="contact-name-error"
						/>
						<p
							id="contact-name-error"
							data-error-for="name"
							hidden
							class="mt-1.5 text-xs text-danger"
						></p>
					</div>
					<div>
						<label
							for="contact-email"
							class="mb-1.5 block font-mono text-[0.65rem] tracking-wide text-muted uppercase"
						>
							{t.contact.formEmail}
						</label>
						<input
							id="contact-email"
							name="email"
							type="email"
							autocomplete="email"
							required
							maxlength="200"
							class="input"
							aria-describedby="contact-email-error"
						/>
						<p
							id="contact-email-error"
							data-error-for="email"
							hidden
							class="mt-1.5 text-xs text-danger"
						></p>
					</div>
				</div>

				<div>
					<label
						for="contact-message"
						class="mb-1.5 block font-mono text-[0.65rem] tracking-wide text-muted uppercase"
					>
						{t.contact.formMessage}
					</label>
					<textarea
						id="contact-message"
						name="message"
						rows="6"
						required
						minlength="10"
						maxlength="5000"
						class="input resize-y"
						aria-describedby="contact-message-error"
					></textarea>
					<p
						id="contact-message-error"
						data-error-for="message"
						hidden
						class="mt-1.5 text-xs text-danger"
					></p>
				</div>

				<div class="flex flex-wrap items-center gap-4">
					<button
						type="submit"
						data-contact-submit
						class="btn-primary"
						data-label-idle={t.contact.formSubmit}
						data-label-sending={t.contact.formSending}
					>
						<Icon name="mail" size={16} />
						<span data-submit-label>{t.contact.formSubmit}</span>
					</button>
					<p class="text-xs leading-relaxed text-muted">{t.contact.formNote}</p>
				</div>

				<p
					data-contact-status
					role="status"
					aria-live="polite"
					class="border border-line bg-paper px-4 py-3 text-sm text-muted"
					hidden
				></p>
				<noscript>
					<p class="border border-dashed border-line bg-paper px-4 py-3 text-sm text-muted">
						{t.contact.formServiceUnavailable}
						<a href={`mailto:${SITE.email}`} class="font-semibold text-accent-strong underline">
							{t.contact.formFallback}
						</a>
					</p>
				</noscript>
			</form>
		</section>
	</div>
</section>

<script>
	import { actions, isInputError } from 'astro:actions';

	function initContactForm() {
		const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
		if (!form || form.dataset.bound === 'true') return;
		form.dataset.bound = 'true';

		const submit = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
		const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
		const status = form.querySelector<HTMLElement>('[data-contact-status]');
		const fields = ['name', 'email', 'message'] as const;

		const setStatus = (message: string, visible = true) => {
			if (!status) return;
			status.textContent = message;
			status.hidden = !visible;
		};

		const clearErrors = () => {
			for (const field of fields) {
				const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
				const input = form.elements.namedItem(field);
				if (error) {
					error.hidden = true;
					error.textContent = '';
				}
				if (input instanceof HTMLElement) input.removeAttribute('aria-invalid');
			}
		};

		const setSending = (sending: boolean) => {
			if (submit) submit.disabled = sending;
			form.setAttribute('aria-busy', String(sending));
			if (submitLabel && submit) {
				submitLabel.textContent = sending
					? (submit.dataset.labelSending ?? '')
					: (submit.dataset.labelIdle ?? '');
			}
		};

		form.addEventListener('input', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement) || !target.getAttribute('name')) return;
			const error = form.querySelector<HTMLElement>(
				`[data-error-for="${target.getAttribute('name')}"]`
			);
			if (error) {
				error.hidden = true;
				error.textContent = '';
			}
			target.removeAttribute('aria-invalid');
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors();
			setStatus('', false);

			if (!form.reportValidity()) return;

			setSending(true);
			const data = new FormData(form);
			const result = await actions.contact(data);

			if (result.error) {
				setSending(false);
				if (isInputError(result.error)) {
					for (const field of fields) {
						const messages = result.error.fields[field];
						if (!messages?.length) continue;
						const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
						const input = form.elements.namedItem(field);
						if (error) {
							error.textContent = messages.join(' ');
							error.hidden = false;
						}
						if (input instanceof HTMLElement) input.setAttribute('aria-invalid', 'true');
					}
					setStatus(form.dataset.msgError ?? '');
					return;
				}
				setStatus(
					result.error.code === 'SERVICE_UNAVAILABLE'
						? (form.dataset.msgUnavailable ?? '')
						: (form.dataset.msgError ?? '')
				);
				return;
			}

			form.reset();
			setSending(false);
			setStatus(form.dataset.msgSuccess ?? '');
		});
	}

	initContactForm();
	document.addEventListener('astro:page-load', initContactForm);
</script>
