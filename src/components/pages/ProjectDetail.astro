---
/**
 * Ficha de proyecto: problema → decisiones técnicas → resultado → stack → enlaces.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useUI } from '../../i18n/ui';
import { projectsIndexPath, type Locale } from '../../i18n/utils';
import { getCover } from '../../lib/covers';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
	project: CollectionEntry<'projects'>;
}

const { locale, project } = Astro.props;
const t = useUI(locale);
const { title, tagline, stack, cover, coverAlt, links, problem, decisions, result, metrics, technicalNotes, architecturePending } = project.data;

const coverImage = getCover(cover);
const indexPath = projectsIndexPath(locale);
const technicalItems = technicalNotes[locale];
const linkIcon: Record<string, 'github' | 'external'> = { repo: 'github', demo: 'external', web: 'external', store: 'external' };
const primaryLinks = links.filter((l) => l.kind !== 'repo');
const repoLinks = links.filter((l) => l.kind === 'repo');
const headerLinks = [...primaryLinks, ...repoLinks];
---

<article class="container-page py-10 sm:py-14">
	<a
		href={indexPath}
		class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
	>
		<Icon name="arrow-left" size={15} />
		{t.project.back}
	</a>

	<header class="mt-6 max-w-3xl space-y-5">
		<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title[locale]}</h1>
		<p class="text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">{tagline[locale]}</p>
		{headerLinks.length > 0 && (
			<div class="flex flex-wrap gap-3">
				{headerLinks.map((link) => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class={link.kind === 'repo' ? 'btn-secondary' : 'btn-primary'}
					>
						<Icon name={linkIcon[link.kind]} size={16} />
						{link.label[locale]}
					</a>
				))}
			</div>
		)}
	</header>

	{
		coverImage ? (
			<figure class="mt-10">
				<Image
					src={coverImage}
					alt={coverAlt[locale]}
					width={1200}
					format="webp"
					quality={85}
					fetchpriority="high"
					class="w-full rounded-2xl border border-neutral-200 dark:border-neutral-800"
				/>
				<figcaption class="sr-only">{coverAlt[locale]}</figcaption>
			</figure>
		) : (
			<div
				class="mt-10 flex aspect-video w-full items-center justify-center rounded-2xl border-2 border-dashed border-neutral-300 font-mono text-xs text-neutral-500 dark:border-neutral-800 dark:text-neutral-500"
			>
				{t.project.coverPending}
			</div>
		)
	}

	<div class="mt-12 grid gap-12 lg:grid-cols-[1.15fr_0.85fr]">
		<div class="space-y-12">
			<section aria-labelledby="project-problem">
				<h2 id="project-problem" class="section-h2 mb-3">{t.project.problem}</h2>
				<p class="leading-relaxed text-neutral-700 dark:text-neutral-300">{problem[locale]}</p>
			</section>

			<section aria-labelledby="project-decisions">
				<h2 id="project-decisions" class="section-h2 mb-3">{t.project.decisions}</h2>
				<ul class="space-y-3">
					{decisions[locale].map((item) => (
						<li class="flex gap-3 leading-relaxed text-neutral-700 dark:text-neutral-300">
							<Icon name="check" size={16} class="mt-1 shrink-0 text-indigo-600 dark:text-indigo-400" />
							<span>{item}</span>
						</li>
					))}
				</ul>
				{technicalItems.length > 0 && (
					<div
						class="mt-6 rounded-2xl border border-dashed border-neutral-300 bg-neutral-50 p-5 dark:border-neutral-800 dark:bg-neutral-900/60"
					>
						<h3 class="font-mono text-xs font-semibold tracking-[0.15em] text-neutral-500 uppercase">
							{t.project.technicalNotes}
						</h3>
						<ul class="mt-3 space-y-2">
							{technicalItems.map((item) => (
								<li class="font-mono text-xs leading-relaxed text-neutral-500">{item}</li>
							))}
						</ul>
					</div>
				)}
			</section>

			<section aria-labelledby="project-result">
				<h2 id="project-result" class="section-h2 mb-3">{t.project.result}</h2>
				<p class="leading-relaxed text-neutral-700 dark:text-neutral-300">{result[locale]}</p>
			</section>

			{metrics.length > 0 && (
				<section aria-labelledby="project-metrics">
					<h2 id="project-metrics" class="section-h2 mb-2">{t.project.metrics}</h2>
					<p class="mb-4 text-sm text-neutral-500 dark:text-neutral-500">
						{t.project.metricsPending}
					</p>
					<ul class="grid gap-3 sm:grid-cols-3">
						{metrics.map((metric) => (
							<li
								class="rounded-xl border border-dashed border-neutral-300 px-4 py-3 font-mono text-xs leading-relaxed text-neutral-500 dark:border-neutral-800 dark:text-neutral-500"
							>
								{metric}
							</li>
						))}
					</ul>
				</section>
			)}

			{architecturePending && (
				<section aria-labelledby="project-architecture">
					<h2 id="project-architecture" class="section-h2 mb-3">{t.project.architecture}</h2>
					<div
						class="flex aspect-video items-center justify-center rounded-2xl border-2 border-dashed border-neutral-300 font-mono text-xs text-neutral-500 dark:border-neutral-800 dark:text-neutral-500"
					>
						{t.project.architecturePending}
					</div>
				</section>
			)}
		</div>

		<aside class="space-y-10">
			<section aria-labelledby="project-stack">
				<h2 id="project-stack" class="section-h2 mb-4">{t.project.stack}</h2>
				<ul class="flex flex-wrap gap-1.5">
					{stack.map((tech) => (
						<li class="chip">{tech}</li>
					))}
				</ul>
			</section>

			{links.length > 0 && (
				<section aria-labelledby="project-links">
					<h2 id="project-links" class="section-h2 mb-4">{t.project.links}</h2>
					<ul class="space-y-2.5">
						{links.map((link) => (
							<li>
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center justify-between gap-3 rounded-xl border border-neutral-200 px-4 py-3 text-sm font-medium transition-colors hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
								>
									<span class="inline-flex items-center gap-2.5">
										<Icon name={linkIcon[link.kind]} size={16} class="text-neutral-400" />
										{link.label[locale]}
									</span>
									<Icon name="external" size={14} class="shrink-0 text-neutral-400" />
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</aside>
	</div>
</article>
