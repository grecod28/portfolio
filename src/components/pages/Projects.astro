---
/**
 * Listado de proyectos con filtro por tecnología (compartido entre /es y /en).
 */
import { getCollection } from 'astro:content';
import { useUI } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
import ProjectCard from '../ProjectCard.astro';
import Icon from '../Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const allTechs = [...new Set(projects.flatMap((p) => p.data.stack))].sort();
---

<section class="container-page py-12 sm:py-16">
	<header class="max-w-3xl">
		<p class="section-label">02 / {t.nav.projects}</p>
		<h1 class="mt-3 text-3xl font-semibold tracking-[-0.045em] text-balance sm:text-4xl">
			{t.projects.title}
		</h1>
		<p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-muted">{t.projects.intro}</p>
		<div class="mt-6 flex flex-wrap gap-6 border-y border-line py-4">
			<p class="font-mono text-[0.65rem] tracking-wide text-muted uppercase">
				<span class="text-ink">{projects.length}</span> {t.projects.totalLabel}
			</p>
			<p class="font-mono text-[0.65rem] tracking-wide text-muted uppercase">
				<span class="text-ink">{projects.filter((p) => p.data.featured).length}</span>{' '}
				{t.projects.featuredLabel}
			</p>
			<p class="font-mono text-[0.65rem] tracking-wide text-muted uppercase">
				<span class="text-ink">{allTechs.length}</span> {t.projects.techLabel}
			</p>
		</div>
	</header>

	<div class="mt-10" data-filter>
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="section-label">{t.projects.filterLabel}</p>
				<div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={t.projects.filterLabel}>
					<button
						type="button"
						data-filter-btn="all"
						aria-pressed="true"
						aria-controls="projects-grid"
						class="filter-btn filter-btn-active"
					>
						{t.projects.all}
					</button>
					{allTechs.map((tech) => (
						<button
							type="button"
							data-filter-btn={tech}
							aria-pressed="false"
							aria-controls="projects-grid"
							class="filter-btn"
						>
							{tech}
						</button>
					))}
				</div>
			</div>
			<p
				data-filter-count
				data-count-label={t.projects.results}
				class="font-mono text-[0.65rem] tracking-wide text-muted uppercase"
				aria-live="polite"
			>
				{projects.length} {t.projects.results}
			</p>
		</div>

		<ul id="projects-grid" class="mt-8 grid gap-4 md:grid-cols-4" data-grid>
			{projects.map((project, index) => (
				<li
					class:list={[
						'reveal min-h-0',
						index === 0 ? 'md:col-span-2 md:row-span-2' : 'md:col-span-2 lg:col-span-1',
					]}
					data-project
					data-techs={JSON.stringify(project.data.stack)}
				>
					<ProjectCard {project} {locale} variant={index === 0 ? 'large' : 'default'} />
				</li>
			))}
		</ul>

		<div
			data-empty
			hidden
			class="mt-10 flex flex-col items-center border border-dashed border-line bg-surface px-6 py-14 text-center"
		>
			<Icon name="search" size={24} class="text-muted" />
			<p class="mt-4 font-mono text-xs tracking-wide text-muted uppercase">
				{t.projects.noResults}
			</p>
			<button type="button" data-filter-reset class="btn-secondary mt-5">
				{t.projects.all}
			</button>
		</div>
	</div>
</section>

<style>
	@reference '../../styles/global.css';

	.filter-btn {
		@apply inline-flex min-h-11 items-center border border-line bg-surface px-3 font-mono text-[0.68rem] tracking-wide text-muted uppercase transition-colors hover:border-accent hover:text-accent-strong;
	}

	.filter-btn-active {
		@apply border-accent bg-accent text-white hover:border-accent hover:text-white;
	}
</style>

<script>
	function initFilter() {
		const root = document.querySelector<HTMLElement>('[data-filter]');
		if (!root || root.dataset.bound === 'true') return;
		root.dataset.bound = 'true';

		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
		const items = Array.from(root.querySelectorAll<HTMLElement>('[data-project]'));
		const empty = root.querySelector<HTMLElement>('[data-empty]');
		const count = root.querySelector<HTMLElement>('[data-filter-count]');
		const reset = root.querySelector<HTMLButtonElement>('[data-filter-reset]');

		const apply = (value: string) => {
			buttons.forEach((button) => {
				const active = button.dataset.filterBtn === value;
				button.setAttribute('aria-pressed', String(active));
				button.classList.toggle('filter-btn-active', active);
			});

			let visible = 0;
			items.forEach((item) => {
				const techs = JSON.parse(item.dataset.techs ?? '[]') as string[];
				const show = value === 'all' || techs.includes(value);
				item.hidden = !show;
				if (show) visible += 1;
			});

			if (empty) empty.hidden = visible > 0;
			if (count) count.textContent = `${visible} ${count.dataset.countLabel ?? ''}`;
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => apply(button.dataset.filterBtn ?? 'all'));
		});

		reset?.addEventListener('click', () => apply('all'));
	}

	initFilter();
	document.addEventListener('astro:page-load', initFilter);
</script>
