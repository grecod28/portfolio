---
interface Props {
	name:
		| 'linkedin'
		| 'github'
		| 'mail'
		| 'external'
		| 'sun'
		| 'moon'
		| 'menu'
		| 'close'
		| 'check'
		| 'download'
		| 'arrow-right'
		| 'arrow-left'
		| 'arrow-up-right'
		| 'arrow-up'
		| 'command'
		| 'search'
		| 'copy'
		| 'info'
		| 'alert'
		| 'chevron-down';
	size?: number;
	class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const paths: Record<string, string> = {
