	search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
	copy: '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M4 16V4a2 2 0 0 1 2-2h12"/>',
