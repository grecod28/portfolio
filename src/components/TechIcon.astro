---
import type { SvgComponent } from 'astro/types';

interface Props {
	icon: SvgComponent;
	name: string;
}

const { icon: IconComponent, name } = Astro.props;
---

<span
	class="flex h-12 w-12 shrink-0 items-center justify-center border border-line bg-white p-2"
	title={name}
>
	<IconComponent width={28} height={28} aria-hidden="true" focusable="false" />
	<span class="sr-only">{name}</span>
</span>
