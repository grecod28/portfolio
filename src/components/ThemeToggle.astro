---
import { useUI } from '../i18n/ui';
import type { Locale } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
---

<button
	type="button"
	data-theme-toggle
	data-light-label={t.theme.light}
	data-dark-label={t.theme.dark}
	aria-label={t.theme.light}
	aria-pressed="false"
	class="inline-flex h-11 w-11 items-center justify-center border border-transparent text-ink transition-colors hover:border-line hover:bg-surface"
>
	<Icon name="sun" size={18} class="hidden dark:block" />
	<Icon name="moon" size={18} class="block dark:hidden" />
</button>

<script>
	function initThemeToggle() {
		const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		if (!button) return;

		const sync = () => {
			const dark = document.documentElement.dataset.theme === 'dark';
			button.setAttribute('aria-pressed', String(dark));
			button.setAttribute(
				'aria-label',
				dark ? (button.dataset.darkLabel ?? '') : (button.dataset.lightLabel ?? '')
			);
		};

		sync();

		if (button.dataset.bound === 'true') return;
		button.dataset.bound = 'true';

		button.addEventListener('click', () => {
			const dark = document.documentElement.dataset.theme !== 'dark';
			document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {
				/* storage no disponible */
			}
			sync();
			document.dispatchEvent(new CustomEvent('portfolio:themechange'));
		});
	}

	initThemeToggle();
	document.addEventListener('astro:page-load', initThemeToggle);
	document.addEventListener('portfolio:themechange', initThemeToggle);
</script>
