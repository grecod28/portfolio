---
import '../styles/global.css';
import { SITE } from '../config';
import { canonicalUrl, translatePath, type Locale } from '../i18n/utils';
import { useUI } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	locale: Locale;
	/** Título único de la página (sin el nombre del sitio). */
	title: string;
	/** Meta description única de la página. */
	description: string;
	/** Ruta relativa de la imagen Open Graph (1200×630). */
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	/** Objetos JSON-LD a inyectar en el head. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	locale,
	title,
	description,
	image = `/og/default-${locale}.png`,
	type = 'website',
	noindex = false,
	jsonLd,
} = Astro.props;

const t = useUI(locale);
const htmlLang = locale === 'es' ? 'es-ES' : 'en-US';
const otherLocales = SITE.locales.filter((l) => l !== locale);
const pathname = Astro.url.pathname;
const canonical = canonicalUrl(pathname);
const ogImage = new URL(image, SITE.url).toString();
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
const ld = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!doctype html>
<html lang={htmlLang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · {SITE.name}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={htmlLang} href={canonical} />
		{
			otherLocales.map((l) => (
				<link
					rel="alternate"
					hreflang={l === 'es' ? 'es-ES' : 'en-US'}
					href={canonicalUrl(translatePath(pathname, l))}
				/>
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={canonicalUrl(translatePath(pathname, SITE.defaultLocale))}
		/>
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content={ogLocale} />
		{
			otherLocales.map((l) => (
				<meta property="og:locale:alternate" content={l === 'es' ? 'es_ES' : 'en_US'} />
			))
		}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{
			ld.map((obj) => (
				<script type="application/ld+json" set:html={JSON.stringify(obj)} />
			))
		}

		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				var dark = stored
					? stored === 'dark'
					: window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			})();
		</script>
	</head>
	<body class="flex min-h-dvh flex-col font-sans">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
		>
			{t.skipToContent}
		</a>
		<Header locale={locale} />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
