{
	"name": "portfolio",
	"type": "module",
	"version": "0.1.0",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"preview:static": "node scripts/serve-static.mjs",
		"astro": "astro",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test tests/a11y",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "astro check && tsc --noEmit",
		"og": "node scripts/generate-og.mjs",
		"lighthouse": "lhci autorun",
		"infra:synth": "cdk synth",
		"prepare": "husky"
	},
	"dependencies": {
		"@astro-aws/adapter": "^2.0.0",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.4.2",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astro-aws/constructs": "^2.0.0",
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.10.0",
		"aws-cdk": "^2.1146.0",
		"aws-cdk-lib": "^2.274.0",
		"constructs": "^10.8.1",
		"eslint": "^10.13.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.13.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"sirv-cli": "^3.0.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
